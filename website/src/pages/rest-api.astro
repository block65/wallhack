---
import DocsLayout from '../layouts/DocsLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import spec from '../data/openapi.json';

type Operation = {
  summary: string;
  description?: string;
  operationId: string;
  security?: Record<string, string[]>[];
  parameters?: { name: string; in: string; required?: boolean; schema: { type: string }; description?: string }[];
  requestBody?: { required?: boolean; content: Record<string, { schema: { $ref?: string; type?: string } }> };
  responses: Record<string, { description: string; content?: Record<string, { schema: { $ref?: string } }> }>;
};

const methodBadge: Record<string, string> = {
  get:    'bg-primary/15 text-primary',
  post:   'bg-green-500/15 text-green-500',
  delete: 'bg-destructive/15 text-destructive',
  put:    'bg-accent/15 text-accent-foreground',
  patch:  'bg-accent/15 text-accent-foreground',
};

function resolveRef(ref: string): Record<string, unknown> {
  const name = ref.replace('#/components/schemas/', '');
  return (spec.components.schemas as Record<string, unknown>)[name] as Record<string, unknown>;
}

function schemaToFields(schema: Record<string, unknown>): { name: string; type: string; description: string }[] {
  if (!schema.properties) return [];
  return Object.entries(schema.properties as Record<string, { type?: string; $ref?: string; description?: string; nullable?: boolean; enum?: string[]; items?: { $ref?: string } }>).map(([name, prop]) => {
    let type = prop.type ?? (prop.$ref ? prop.$ref.replace('#/components/schemas/', '') : 'object');
    if (prop.type === 'array' && prop.items?.$ref) type = `${prop.items.$ref.replace('#/components/schemas/', '')}[]`;
    if (prop.enum) type = prop.enum.map(v => `"${v}"`).join(' | ');
    if (prop.nullable) type = `${type} | null`;
    return { name, type, description: prop.description ?? '' };
  });
}

const endpoints = Object.entries(spec.paths).flatMap(([path, methods]) =>
  Object.entries(methods as Record<string, Operation>).map(([method, op]) => ({
    path, method, ...op,
  }))
);

const startExample = `wallhack entry --listen :443 --api 127.0.0.1:6566`;
const startupOutput = `REST API listening on 127.0.0.1:6566
  Username: admin
  Secret:   a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4  (auto-generated)`;
const customCredsExample = `wallhack entry --listen :443 --api 127.0.0.1:6566 --api-user operator --api-secret mysecret`;
const curlExample = `SECRET=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4  # from startup output

# Get stats
curl -k -u admin:$SECRET https://localhost:6566/stats

# List peers
curl -k -u admin:$SECRET https://localhost:6566/peers

# Add a route through a peer
curl -k -u admin:$SECRET -X POST https://localhost:6566/routes \\
  -H 'Content-Type: application/json' \\
  -d '{"cidr": "192.168.1.0/24", "peer_id": "bench"}'`;
---

<DocsLayout title="REST API" description="Programmatic HTTP interface for headless management of entry nodes.">
  <h1>REST API</h1>

  <p>
    An optional HTTP API provides headless management of entry nodes. It uses the same TLS certificate as the tunnel
    and supports Basic authentication.
  </p>

  <h2>Enabling the API</h2>

  <p>Pass <code>--api &lt;addr&gt;</code> when starting an entry node:</p>

  <CodeBlock code={startExample} />

  <p>
    Basic authentication is always required. A random secret is generated at startup and printed to stdout alongside
    the username:
  </p>

  <CodeBlock code={startupOutput} />

  <p>
    To set fixed credentials, pass <code>--api-user</code> and <code>--api-secret</code>:
  </p>

  <CodeBlock code={customCredsExample} />

  <p>
    The API is served over HTTPS using the same TLS certificate as the tunnel. A self-signed certificate is
    auto-generated unless <code>--cert</code> and <code>--key</code> are provided. Pass <code>-k</code> to
    curl to accept the self-signed certificate.
  </p>

  <h2>Example Usage</h2>

  <CodeBlock code={curlExample} lang="bash" />

  <h2>Endpoints</h2>

  {endpoints.map(({ path, method, summary, description, parameters, requestBody, responses }) => {
    const pathParams = (parameters ?? []).filter(p => p.in === 'path');

    const successResponse = Object.entries(responses).find(([code]) => code.startsWith('2'));
    const successSchema = successResponse?.[1]?.content?.['application/json']?.schema
      ?? successResponse?.[1]?.content?.['text/plain']?.schema
      ?? successResponse?.[1]?.content?.['text/event-stream']?.schema;
    const resolvedSuccess = successSchema?.$ref ? resolveRef(successSchema.$ref) : successSchema;

    const reqBodySchema = requestBody?.content?.['application/json']?.schema;
    const resolvedReqBody = reqBodySchema?.$ref ? resolveRef(reqBodySchema.$ref) : reqBodySchema;

    const fields = resolvedSuccess ? schemaToFields(resolvedSuccess) : [];
    const reqFields = resolvedReqBody ? schemaToFields(resolvedReqBody) : [];

    return (
      <div class="not-prose border border-border rounded-lg overflow-hidden my-6">
        <div class="flex items-center gap-3 px-4 py-3 bg-muted/40 border-b border-border">
          <span class={`font-mono text-xs font-bold uppercase px-2 py-0.5 rounded ${methodBadge[method] ?? ''}`}>
            {method}
          </span>
          <code class="font-mono text-sm text-foreground">{path}</code>
        </div>

        <div class="px-4 py-3 space-y-4">
          <div>
            <p class="font-semibold text-sm text-foreground">{summary}</p>
            {description && <p class="text-sm text-muted-foreground mt-1">{description}</p>}
          </div>

          {pathParams.length > 0 && (
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground mb-2">Parameters</p>
              <table class="w-full text-sm">
                <tbody>
                  {pathParams.map(p => (
                    <tr class="border-b border-border/50">
                      <td class="py-1 pr-4 w-32"><code class="font-mono text-xs">{p.name}</code></td>
                      <td class="py-1 pr-4 text-muted-foreground text-xs w-24">{p.schema.type}</td>
                      <td class="py-1 text-muted-foreground text-xs">{p.description}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {reqFields.length > 0 && (
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground mb-2">Body</p>
              <table class="w-full text-sm">
                <tbody>
                  {reqFields.map(f => (
                    <tr class="border-b border-border/50">
                      <td class="py-1 pr-4 w-32"><code class="font-mono text-xs">{f.name}</code></td>
                      <td class="py-1 pr-4 text-muted-foreground text-xs w-24">{f.type}</td>
                      <td class="py-1 text-muted-foreground text-xs">{f.description}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {fields.length > 0 && (
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground mb-2">Response</p>
              <table class="w-full text-sm">
                <tbody>
                  {fields.map(f => (
                    <tr class="border-b border-border/50">
                      <td class="py-1 pr-4 w-32"><code class="font-mono text-xs">{f.name}</code></td>
                      <td class="py-1 pr-4 text-muted-foreground text-xs w-24">{f.type}</td>
                      <td class="py-1 text-muted-foreground text-xs">{f.description}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </div>
    );
  })}
</DocsLayout>
