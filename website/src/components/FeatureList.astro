---
import { Icon } from 'astro-icon/components';

interface Props {
  title?: string;
  items?: string[];
  icon?: 'check' | 'border' | 'bullet';
}

const { title, items = [], icon = 'border' } = Astro.props;
---

<div data-icon={icon}>
  {title && (
    <h4 class="text-sm font-semibold text-foreground mb-2 font-sans">{title}</h4>
  )}
  <ul class="space-y-1.5 list-content">
    {items.map((item) => (
      <li>
        {icon === 'check' && <Icon name="lucide:check" class="w-4 h-4 text-primary mt-0.5 shrink-0" />}
        {icon === 'bullet' && <span class="text-primary mt-1">•</span>}
        <span>{item}</span>
      </li>
    ))}
    <slot />
  </ul>
</div>

<style>
  @reference "../styles/global.css";

  .list-content :global(li) {
    @apply text-foreground;
  }
  
  [data-icon="border"] .list-content :global(li) {
    @apply pl-4 border-l-2 border-border;
  }
  
  [data-icon="check"] .list-content :global(li),
  [data-icon="bullet"] .list-content :global(li) {
    @apply flex items-start gap-2;
  }
</style>
