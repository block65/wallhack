---
import { Icon } from 'astro-icon/components';

interface Props {
  title?: string;
  icon?: 'check' | 'border' | 'bullet';
}

const { title, icon = 'border' } = Astro.props;
---

<div>
  {title && (
    <h4 class="text-sm font-semibold text-foreground mb-2 font-sans">{title}</h4>
  )}
  <ul class="space-y-1.5 list-content">
    <slot />
  </ul>
</div>

<style>
  .list-content :global(li) {
    @apply text-sm text-muted-foreground;
  }
  
  :global([data-icon="border"]) .list-content :global(li) {
    @apply pl-4 border-l-2 border-border;
  }
  
  :global([data-icon="check"]) .list-content :global(li),
  :global([data-icon="bullet"]) .list-content :global(li) {
    @apply flex items-start gap-2;
  }
</style>
