---
interface Props {
  title: string;
  number?: number;
}

const { title, number } = Astro.props;
---

<div class="space-y-3">
  <div class="flex items-center gap-2">
    {number && (
      <div class="flex shrink-0 items-center justify-center w-6 h-6 rounded-full bg-primary text-primary-foreground text-xs font-semibold leading-none">
        {number}
      </div>
    )}
    <div class="text-base font-semibold text-foreground leading-6">{title}</div>
  </div>
  <div class="pl-8 space-y-3">
    <slot />
  </div>
</div>
