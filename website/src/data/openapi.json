{
	"openapi": "3.1.0",
	"info": {
		"title": "wallhack REST API",
		"version": "0.3.0",
		"description": "Headless control plane for wallhack nodes. All endpoints except /health require Basic authentication when --api-user and --api-secret are configured."
	},
	"servers": [
		{
			"url": "https://127.0.0.1:6564",
			"description": "Local node (default port)"
		}
	],
	"components": {
		"securitySchemes": {
			"basicAuth": {
				"type": "http",
				"scheme": "basic",
				"description": "Configured via --api-user and --api-secret. Optional — if not configured, no authentication is required."
			}
		},
		"schemas": {
			"StatusResponse": {
				"type": "object",
				"required": [
					"name",
					"version",
					"role",
					"uptime_ms",
					"capabilities"
				],
				"properties": {
					"name": {
						"type": "string",
						"description": "Node name (set via --name)."
					},
					"version": {
						"type": "string",
						"description": "Binary version string including git SHA and build timestamp."
					},
					"role": {
						"type": "string",
						"enum": ["entry", "exit", "relay", "indeterminate"],
						"description": "Operational role of this node."
					},
					"uptime_ms": {
						"type": "integer",
						"description": "Node uptime in milliseconds."
					},
					"peer_addr": {
						"type": "string",
						"description": "Remote peer address (present only when connected)."
					},
					"listen_addr": {
						"type": "string",
						"description": "Bound listen address (present only when listening)."
					},
					"capabilities": {
						"type": "object",
						"required": ["tun_capable", "listening", "connecting"],
						"properties": {
							"tun_capable": {
								"type": "boolean",
								"description": "Whether the node can create TUN interfaces."
							},
							"listening": {
								"type": "boolean",
								"description": "Whether the node is accepting peer connections."
							},
							"connecting": {
								"type": "boolean",
								"description": "Whether the node connects to a peer."
							}
						}
					}
				}
			},
			"StatsResponse": {
				"type": "object",
				"required": [
					"bytes_in",
					"bytes_out",
					"packets_in",
					"packets_out",
					"active_connections",
					"active_flows"
				],
				"properties": {
					"bytes_in": {
						"type": "integer",
						"description": "Total bytes received by the node."
					},
					"bytes_out": {
						"type": "integer",
						"description": "Total bytes transmitted by the node."
					},
					"packets_in": {
						"type": "integer",
						"description": "Total packets received by the node."
					},
					"packets_out": {
						"type": "integer",
						"description": "Total packets transmitted by the node."
					},
					"active_connections": {
						"type": "integer",
						"description": "Number of currently active peer connections."
					},
					"active_flows": {
						"type": "integer",
						"description": "Number of active L4 network flows being tracked."
					}
				}
			},
			"PeerResponse": {
				"type": "object",
				"required": [
					"id",
					"name",
					"addr",
					"role",
					"connect_time",
					"bytes_transferred"
				],
				"properties": {
					"id": {
						"type": "string",
						"description": "Unique registry key. Equals name unless disambiguated (e.g. foo#3). Use this for DELETE /peers/{id}."
					},
					"name": {
						"type": "string",
						"description": "User-provided peer name (from --name). May repeat across connections."
					},
					"addr": {
						"type": "string",
						"description": "Remote socket address of the peer."
					},
					"role": {
						"type": "string",
						"enum": ["entry", "exit", "relay", "indeterminate", "unknown"],
						"description": "Negotiated role of the connected peer."
					},
					"connect_time": {
						"type": "string",
						"format": "date-time",
						"description": "ISO 8601 UTC timestamp when the connection was established."
					},
					"bytes_transferred": {
						"type": "integer",
						"description": "Total data volume exchanged with this peer."
					},
					"latency_ms": {
						"type": "number",
						"nullable": true,
						"description": "Current round-trip time (RTT) to the peer in milliseconds."
					}
				}
			},
			"PeersResponse": {
				"type": "object",
				"required": ["peers"],
				"properties": {
					"peers": {
						"type": "array",
						"items": { "$ref": "#/components/schemas/PeerResponse" },
						"description": "List of all currently connected peers."
					}
				}
			},
			"RouteAddRequest": {
				"type": "object",
				"required": ["cidr", "peer"],
				"properties": {
					"cidr": {
						"type": "string",
						"description": "Target network in CIDR notation (e.g., 10.0.0.0/24)."
					},
					"peer": {
						"type": "string",
						"description": "Name of the peer through which the network should be routed."
					}
				}
			},
			"RouteResponse": {
				"type": "object",
				"required": ["cidr", "peer", "create_time"],
				"properties": {
					"cidr": {
						"type": "string",
						"description": "Network range routed through the tunnel."
					},
					"peer": {
						"type": "string",
						"description": "Name of the peer responsible for this route."
					},
					"create_time": {
						"type": "string",
						"format": "date-time",
						"description": "ISO 8601 UTC timestamp when the route was established."
					}
				}
			},
			"RoutesResponse": {
				"type": "object",
				"required": ["routes"],
				"properties": {
					"routes": {
						"type": "array",
						"items": { "$ref": "#/components/schemas/RouteResponse" },
						"description": "List of active routing entries."
					}
				}
			},
			"SuccessResponse": {
				"type": "object",
				"required": ["success"],
				"properties": {
					"success": {
						"type": "boolean",
						"description": "Indicates if the requested operation completed successfully."
					},
					"message": {
						"type": "string",
						"description": "Optional detail providing context for success or failure."
					}
				}
			}
		}
	},
	"paths": {
		"/health": {
			"get": {
				"summary": "Process health",
				"description": "Verifies that the node process is active and responding. Always returns 200. No authentication required.",
				"operationId": "health",
				"security": [],
				"responses": {
					"200": {
						"description": "Node process is responsive.",
						"content": {
							"text/plain": { "schema": { "type": "string", "example": "ok" } }
						}
					}
				}
			}
		},
		"/status": {
			"get": {
				"summary": "Node status",
				"description": "Retrieves node identity, role, capabilities, and uptime.",
				"operationId": "status",
				"security": [{ "basicAuth": [] }],
				"responses": {
					"200": {
						"description": "Status retrieved.",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/StatusResponse" }
							}
						}
					},
					"401": { "description": "Unauthorized." }
				}
			}
		},
		"/stats": {
			"get": {
				"summary": "Traffic metrics",
				"description": "Retrieves current traffic volume and flow statistics.",
				"operationId": "stats",
				"security": [{ "basicAuth": [] }],
				"responses": {
					"200": {
						"description": "Metrics retrieved.",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/StatsResponse" }
							}
						}
					},
					"401": { "description": "Unauthorized." }
				}
			}
		},
		"/peers": {
			"get": {
				"summary": "List connections",
				"description": "Retrieves a list of all currently connected peers.",
				"operationId": "listPeers",
				"security": [{ "basicAuth": [] }],
				"responses": {
					"200": {
						"description": "Connections retrieved.",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/PeersResponse" }
							}
						}
					},
					"401": { "description": "Unauthorized." }
				}
			}
		},
		"/peers/{id}": {
			"delete": {
				"summary": "Disconnect peer",
				"description": "Terminates the connection with a specific peer. Accepts the peer's unique id (from GET /peers) or an unambiguous name prefix.",
				"operationId": "disconnectPeer",
				"security": [{ "basicAuth": [] }],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": { "type": "string" },
						"description": "Peer id (or unambiguous name prefix) to disconnect."
					}
				],
				"responses": {
					"200": {
						"description": "Peer disconnected.",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/SuccessResponse" }
							}
						}
					},
					"400": { "description": "Malformed peer name." },
					"401": { "description": "Unauthorized." },
					"404": { "description": "Specified peer not found." }
				}
			}
		},
		"/routes": {
			"get": {
				"summary": "List routing table",
				"description": "Retrieves all active routing entries established through this node.",
				"operationId": "listRoutes",
				"security": [{ "basicAuth": [] }],
				"responses": {
					"200": {
						"description": "Routing table retrieved.",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/RoutesResponse" }
							}
						}
					},
					"401": { "description": "Unauthorized." }
				}
			},
			"post": {
				"summary": "Add route",
				"description": "Configures a new route to a target network through an active peer.",
				"operationId": "addRoute",
				"security": [{ "basicAuth": [] }],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/RouteAddRequest" }
						}
					}
				},
				"responses": {
					"201": {
						"description": "Route established.",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/SuccessResponse" }
							}
						}
					},
					"400": {
						"description": "Invalid network specification or peer name."
					},
					"401": { "description": "Unauthorized." }
				}
			}
		},
		"/events": {
			"get": {
				"summary": "Event stream",
				"description": "Server-Sent Events stream of peer lifecycle events (connect/disconnect). The stream sends `peer_connected` and `peer_disconnected` events with JSON payloads. Keep-alive comments are sent every 15 seconds.",
				"operationId": "events",
				"security": [{ "basicAuth": [] }],
				"responses": {
					"200": {
						"description": "SSE stream opened.",
						"content": {
							"text/event-stream": {
								"schema": { "type": "string" }
							}
						}
					},
					"401": { "description": "Unauthorized." }
				}
			}
		},
		"/routes/{cidr}": {
			"delete": {
				"summary": "Remove route",
				"description": "Deletes a routing entry by its network specification.",
				"operationId": "deleteRoute",
				"security": [{ "basicAuth": [] }],
				"parameters": [
					{
						"name": "cidr",
						"in": "path",
						"required": true,
						"schema": { "type": "string" },
						"description": "URL-encoded CIDR specification (e.g., 10.0.0.0%2F24)."
					}
				],
				"responses": {
					"200": {
						"description": "Route removed.",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/SuccessResponse" }
							}
						}
					},
					"400": { "description": "Invalid CIDR format." },
					"401": { "description": "Unauthorized." },
					"404": { "description": "Specified route does not exist." }
				}
			}
		}
	}
}
