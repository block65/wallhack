{
	"openapi": "3.1.0",
	"info": {
		"title": "wallhack REST API",
		"version": "0.4.0",
		"description": "Headless control plane for wallhack nodes. All endpoints except /health require Basic authentication when --api-user and --api-secret are configured."
	},
	"servers": [
		{
			"url": "https://127.0.0.1:6564",
			"description": "Local node (default port)"
		}
	],
	"components": {
		"securitySchemes": {
			"basicAuth": {
				"type": "http",
				"scheme": "basic",
				"description": "Configured via --api-user and --api-secret. Optional — if not configured, no authentication is required."
			}
		},
		"schemas": {
			"InfoResponse": {
				"type": "object",
				"required": ["name", "version", "role", "uptime_ms", "capabilities"],
				"properties": {
					"name": {
						"type": "string",
						"description": "Node name (set via --name)."
					},
					"version": {
						"type": "string",
						"description": "Binary version string including git SHA and build timestamp."
					},
					"role": {
						"type": "string",
						"enum": ["entry", "exit", "relay", "indeterminate"],
						"description": "Operational role of this node."
					},
					"uptime_ms": {
						"type": "integer",
						"description": "Node uptime in milliseconds."
					},
					"peer_addr": {
						"type": "string",
						"description": "Remote peer address (present only when connected)."
					},
					"listen_addr": {
						"type": "string",
						"description": "Bound listen address (present only when listening)."
					},
					"capabilities": {
						"type": "object",
						"required": ["tun_capable", "listening", "connecting"],
						"properties": {
							"tun_capable": {
								"type": "boolean",
								"description": "Whether the node can create TUN interfaces."
							},
							"listening": {
								"type": "boolean",
								"description": "Whether the node is accepting peer connections."
							},
							"connecting": {
								"type": "boolean",
								"description": "Whether the node connects to a peer."
							}
						}
					}
				}
			},
			"StatsResponse": {
				"type": "object",
				"required": [
					"bytes_in",
					"bytes_out",
					"packets_in",
					"packets_out",
					"active_connections",
					"active_flows",
					"packets_dropped",
					"total_connections",
					"total_flows"
				],
				"properties": {
					"bytes_in": {
						"type": "integer",
						"description": "Total bytes received by the node."
					},
					"bytes_out": {
						"type": "integer",
						"description": "Total bytes transmitted by the node."
					},
					"packets_in": {
						"type": "integer",
						"description": "Total packets received by the node."
					},
					"packets_out": {
						"type": "integer",
						"description": "Total packets transmitted by the node."
					},
					"active_connections": {
						"type": "integer",
						"description": "Number of currently active peer connections."
					},
					"active_flows": {
						"type": "integer",
						"description": "Number of active L4 network flows being tracked."
					},
					"packets_dropped": {
						"type": "integer",
						"description": "Total packets dropped since daemon start."
					},
					"total_connections": {
						"type": "integer",
						"description": "Total peer connections opened since daemon start (monotonically increasing)."
					},
					"total_flows": {
						"type": "integer",
						"description": "Total L4 flows opened since daemon start (monotonically increasing)."
					}
				}
			},
			"PeerResponse": {
				"type": "object",
				"required": [
					"id",
					"name",
					"addr",
					"role",
					"connect_time",
					"bytes_transferred"
				],
				"properties": {
					"id": {
						"type": "string",
						"description": "Unique registry key. Equals name unless disambiguated (e.g. foo#3). Use this for DELETE /peers/{id}."
					},
					"name": {
						"type": "string",
						"description": "User-provided peer name (from --name). May repeat across connections."
					},
					"addr": {
						"type": "string",
						"description": "Remote socket address of the peer."
					},
					"role": {
						"type": "string",
						"enum": ["entry", "exit", "relay", "indeterminate", "unknown"],
						"description": "Negotiated role of the connected peer."
					},
					"connect_time": {
						"type": "string",
						"format": "date-time",
						"description": "ISO 8601 UTC timestamp when the connection was established."
					},
					"bytes_transferred": {
						"type": "integer",
						"description": "Total data volume exchanged with this peer."
					},
					"latency_ms": {
						"type": "number",
						"nullable": true,
						"description": "Current round-trip time (RTT) to the peer in milliseconds."
					}
				}
			},
			"PeersResponse": {
				"type": "object",
				"required": ["peers"],
				"properties": {
					"peers": {
						"type": "array",
						"items": { "$ref": "#/components/schemas/PeerResponse" },
						"description": "List of all currently connected peers."
					}
				}
			},
			"RouteAddRequest": {
				"type": "object",
				"required": ["cidr", "peer"],
				"properties": {
					"cidr": {
						"type": "string",
						"description": "Target network in CIDR notation (e.g., 10.0.0.0/24)."
					},
					"peer": {
						"type": "string",
						"description": "Name of the peer through which the network should be routed."
					}
				}
			},
			"RouteResponse": {
				"type": "object",
				"required": ["cidr", "peer", "create_time"],
				"properties": {
					"cidr": {
						"type": "string",
						"description": "Network range routed through the tunnel."
					},
					"peer": {
						"type": "string",
						"description": "Name of the peer responsible for this route."
					},
					"create_time": {
						"type": "string",
						"format": "date-time",
						"description": "ISO 8601 UTC timestamp when the route was established."
					}
				}
			},
			"RoutesResponse": {
				"type": "object",
				"required": ["routes"],
				"properties": {
					"routes": {
						"type": "array",
						"items": { "$ref": "#/components/schemas/RouteResponse" },
						"description": "List of active routing entries."
					}
				}
			},
			"SuccessResponse": {
				"type": "object",
				"required": ["success"],
				"properties": {
					"success": {
						"type": "boolean",
						"description": "Indicates if the requested operation completed successfully."
					},
					"message": {
						"type": "string",
						"description": "Optional detail providing context for success or failure."
					}
				}
			},
			"ConnectRequest": {
				"type": "object",
				"required": ["addr"],
				"properties": {
					"addr": {
						"type": "string",
						"description": "Remote peer address to connect to (e.g., quic://1.2.3.4:4433)."
					}
				}
			},
			"ConnectResponse": {
				"type": "object",
				"required": ["peer_addr", "protocol"],
				"properties": {
					"peer_addr": {
						"type": "string",
						"description": "Resolved remote peer address."
					},
					"protocol": {
						"type": "string",
						"description": "Transport protocol used (QUIC or WebSocket)."
					}
				}
			},
			"ListenRequest": {
				"type": "object",
				"required": ["addr"],
				"properties": {
					"addr": {
						"type": "string",
						"description": "Address to listen on (e.g., quic://0.0.0.0:4433)."
					}
				}
			},
			"ListenResponse": {
				"type": "object",
				"required": ["listen_addr", "protocol", "fingerprint"],
				"properties": {
					"listen_addr": {
						"type": "string",
						"description": "Actual bound address (important if port was 0)."
					},
					"protocol": {
						"type": "string",
						"description": "Transport protocol used (QUIC or WebSocket)."
					},
					"fingerprint": {
						"type": "string",
						"description": "Certificate fingerprint (SHA-256) for peer verification."
					}
				}
			},
			"LogsResponse": {
				"type": "object",
				"required": ["lines"],
				"properties": {
					"lines": {
						"type": "array",
						"items": { "type": "string" },
						"description": "Recent daemon log lines, oldest first."
					}
				}
			},
			"RoleSetRequest": {
				"type": "object",
				"required": ["role"],
				"properties": {
					"role": {
						"type": "string",
						"enum": ["auto", "entry", "exit", "relay"],
						"description": "Target role, or \"auto\" to clear all preferences."
					},
					"level": {
						"type": "string",
						"enum": ["prefer", "exclude", "fixed"],
						"default": "fixed",
						"description": "How to apply: fixed (default, force), prefer (soft), exclude (avoid)."
					}
				}
			}
		}
	},
	"paths": {
		"/health": {
			"get": {
				"summary": "Process health",
				"description": "Verifies that the node process is active and responding. Always returns 200. No authentication required.",
				"operationId": "health",
				"security": [],
				"responses": {
					"200": {
						"description": "Node process is responsive.",
						"content": {
							"text/plain": { "schema": { "type": "string", "example": "ok" } }
						}
					}
				}
			}
		},
		"/info": {
			"get": {
				"summary": "Node info",
				"description": "Retrieves node identity, role, capabilities, and uptime.",
				"operationId": "infoGet",
				"security": [{ "basicAuth": [] }],
				"responses": {
					"200": {
						"description": "Info retrieved.",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/InfoResponse" }
							}
						}
					},
					"401": { "description": "Unauthorized." }
				}
			}
		},
		"/logs": {
			"get": {
				"summary": "Recent daemon logs",
				"description": "Retrieves recent log lines from the daemon's in-memory ring buffer (last 200 lines max).",
				"operationId": "logs",
				"security": [{ "basicAuth": [] }],
				"parameters": [
					{
						"name": "lines",
						"in": "query",
						"required": false,
						"schema": { "type": "integer", "default": 0 },
						"description": "Number of recent lines to return. 0 or omit for all buffered lines."
					}
				],
				"responses": {
					"200": {
						"description": "Log lines retrieved.",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/LogsResponse" }
							}
						}
					},
					"401": { "description": "Unauthorized." }
				}
			}
		},
		"/stats": {
			"get": {
				"summary": "Traffic metrics",
				"description": "Retrieves current traffic volume and flow statistics.",
				"operationId": "stats",
				"security": [{ "basicAuth": [] }],
				"responses": {
					"200": {
						"description": "Metrics retrieved.",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/StatsResponse" }
							}
						}
					},
					"401": { "description": "Unauthorized." }
				}
			}
		},
		"/peers": {
			"get": {
				"summary": "List connections",
				"description": "Retrieves a list of all currently connected peers.",
				"operationId": "peersList",
				"security": [{ "basicAuth": [] }],
				"responses": {
					"200": {
						"description": "Connections retrieved.",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/PeersResponse" }
							}
						}
					},
					"401": { "description": "Unauthorized." }
				}
			}
		},
		"/peers/{id}": {
			"delete": {
				"summary": "Disconnect peer",
				"description": "Terminates the connection with a specific peer. Accepts the peer's unique id (from GET /peers) or an unambiguous name prefix.",
				"operationId": "peerDisconnect",
				"security": [{ "basicAuth": [] }],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": { "type": "string" },
						"description": "Peer id (or unambiguous name prefix) to disconnect."
					}
				],
				"responses": {
					"200": {
						"description": "Peer disconnected.",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/SuccessResponse" }
							}
						}
					},
					"400": { "description": "Malformed peer name." },
					"401": { "description": "Unauthorized." },
					"404": { "description": "Specified peer not found." }
				}
			}
		},
		"/routes": {
			"get": {
				"summary": "List routing table",
				"description": "Retrieves all active routing entries established through this node.",
				"operationId": "routesList",
				"security": [{ "basicAuth": [] }],
				"responses": {
					"200": {
						"description": "Routing table retrieved.",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/RoutesResponse" }
							}
						}
					},
					"401": { "description": "Unauthorized." }
				}
			},
			"post": {
				"summary": "Add route",
				"description": "Configures a new route to a target network through an active peer.",
				"operationId": "routeAdd",
				"security": [{ "basicAuth": [] }],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/RouteAddRequest" }
						}
					}
				},
				"responses": {
					"201": {
						"description": "Route established.",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/SuccessResponse" }
							}
						}
					},
					"400": {
						"description": "Invalid network specification or peer name."
					},
					"401": { "description": "Unauthorized." }
				}
			}
		},
		"/events": {
			"get": {
				"summary": "Event stream",
				"description": "Server-Sent Events stream of peer lifecycle events (connect/disconnect). The stream sends `peer_connected` and `peer_disconnected` events with JSON payloads. Keep-alive comments are sent every 15 seconds.",
				"operationId": "events",
				"security": [{ "basicAuth": [] }],
				"responses": {
					"200": {
						"description": "SSE stream opened.",
						"content": {
							"text/event-stream": {
								"schema": { "type": "string" }
							}
						}
					},
					"401": { "description": "Unauthorized." }
				}
			}
		},
		"/routes/{cidr}": {
			"delete": {
				"summary": "Delete route",
				"description": "Deletes a routing entry by its network specification.",
				"operationId": "routeDel",
				"security": [{ "basicAuth": [] }],
				"parameters": [
					{
						"name": "cidr",
						"in": "path",
						"required": true,
						"schema": { "type": "string" },
						"description": "URL-encoded CIDR specification (e.g., 10.0.0.0%2F24)."
					}
				],
				"responses": {
					"200": {
						"description": "Route removed.",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/SuccessResponse" }
							}
						}
					},
					"400": { "description": "Invalid CIDR format." },
					"401": { "description": "Unauthorized." },
					"404": { "description": "Specified route does not exist." }
				}
			}
		},
		"/connect": {
			"post": {
				"summary": "Connect to peer",
				"description": "Initiates an outbound connection to a remote peer.",
				"operationId": "connect",
				"security": [{ "basicAuth": [] }],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/ConnectRequest" }
						}
					}
				},
				"responses": {
					"200": {
						"description": "Connection initiated.",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ConnectResponse" }
							}
						}
					},
					"400": { "description": "Invalid address or connection refused." },
					"401": { "description": "Unauthorized." }
				}
			}
		},
		"/listen": {
			"post": {
				"summary": "Start listener",
				"description": "Begins accepting inbound peer connections on the given address.",
				"operationId": "listen",
				"security": [{ "basicAuth": [] }],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/ListenRequest" }
						}
					}
				},
				"responses": {
					"200": {
						"description": "Listener started.",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ListenResponse" }
							}
						}
					},
					"400": { "description": "Invalid address or already listening." },
					"401": { "description": "Unauthorized." }
				}
			}
		},
		"/disconnect": {
			"post": {
				"summary": "Disconnect transport",
				"description": "Tears down the active transport session (both connect and listen).",
				"operationId": "disconnect",
				"security": [{ "basicAuth": [] }],
				"responses": {
					"200": {
						"description": "Transport disconnected.",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/SuccessResponse" }
							}
						}
					},
					"400": { "description": "Not connected." },
					"401": { "description": "Unauthorized." }
				}
			}
		},
		"/shutdown": {
			"post": {
				"summary": "Shutdown daemon",
				"description": "Initiates graceful shutdown of the daemon process.",
				"operationId": "shutdown",
				"security": [{ "basicAuth": [] }],
				"responses": {
					"200": {
						"description": "Shutdown initiated.",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/SuccessResponse" }
							}
						}
					},
					"401": { "description": "Unauthorized." }
				}
			}
		},
		"/role": {
			"put": {
				"summary": "Set role",
				"description": "Set or clear this node's role. Use role=auto to clear all preferences and return to negotiation.",
				"operationId": "roleSet",
				"security": [{ "basicAuth": [] }],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/RoleSetRequest" }
						}
					}
				},
				"responses": {
					"200": {
						"description": "Role applied.",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/SuccessResponse" }
							}
						}
					},
					"400": { "description": "Invalid level or role." },
					"401": { "description": "Unauthorized." }
				}
			}
		}
	}
}
