set shell := ["bash", "-euo", "pipefail", "-c"]

root := justfile_directory() / ".."

# Build wallhack for musl
build:
    cd {{ root }} && cross build -q --release --target x86_64-unknown-linux-musl

# Start the cyber range
up: build
    docker compose up -d --build

# Stop the cyber range
down:
    docker compose down

# Shell into the attacker container
shell:
    docker exec -it wallhack-range-attacker-1 sh

# Shell into the gateway-perimeter container
shell2:
    docker exec -it wallhack-range-gateway-perimeter-1 sh

# Run range validation tests
test:
    bash test.sh

# Stop and remove all volumes/images
clean:
    docker compose down -v --rmi local
