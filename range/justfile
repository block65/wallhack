set shell := ["bash", "-euo", "pipefail", "-c"]

root := justfile_directory() / ".."

# Build wallhack for musl
build:
    cd {{ root }} && cross build -q --release --target x86_64-unknown-linux-musl

# Start the cyber range (run `just build` first if the binary is outdated)
up:
    docker compose up -d --build

# Stop the cyber range
down:
    docker compose down

# Shell into the attacker container
shell:
    docker exec -it wallhack-range-attacker-1 sh

# Shell into the gateway-perimeter container
shell2:
    docker exec -it wallhack-range-gateway-perimeter-1 sh

# Run range validation tests
test:
    bash test.sh

# Record a demo video to demo.mp4 and demo.gif (requires vhs and tmux)
record:
    @command -v vhs  >/dev/null 2>&1 || { echo "error: vhs not installed — see https://github.com/charmbracelet/vhs"; exit 1; }
    @command -v tmux >/dev/null 2>&1 || { echo "error: tmux not installed"; exit 1; }
    docker compose up -d --build --wait
    vhs demo.tape

# Stop and remove all volumes/images
clean:
    docker compose down -v --rmi local
